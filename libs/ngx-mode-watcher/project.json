{
	"name": "ngx-mode-watcher",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/ngx-mode-watcher/src",
	"prefix": "lib",
	"projectType": "library",
	"tags": [],
	"targets": {
		"build": {
			"executor": "@nx/angular:package",
			"outputs": ["{workspaceRoot}/dist/{projectRoot}"],
			"options": {
				"project": "libs/ngx-mode-watcher/ng-package.json"
			},
			"configurations": {
				"production": {
					"tsConfig": "libs/ngx-mode-watcher/tsconfig.lib.prod.json"
				},
				"development": {
					"tsConfig": "libs/ngx-mode-watcher/tsconfig.lib.json"
				}
			},
			"defaultConfiguration": "production"
		},
		"test": {
			"executor": "@nx/vite:test",
			"outputs": ["{options.reportsDirectory}"],
			"options": {
				"reportsDirectory": "../../coverage/libs/ngx-mode-watcher"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		}
	}
}
